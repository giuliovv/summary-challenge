# Public news API used by lib/news/gnews.ts
GNEWS_API_KEY="replace-me"

# OpenAI API key used by lib/ai/openai.ts
OPENAI_API_KEY="replace-me"

# Neon Postgres connection string.
# Vercel's Neon Marketplace integration injects this automatically in Vercel.
# For local dev, run `vercel env pull .env` or point this at local Postgres.
# For drizzle-kit migrations, use Neon's direct/unpooled connection string here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
