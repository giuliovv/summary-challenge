# Public news API used by lib/news/gnews.ts
GNEWS_API_KEY="replace-me"

# OpenAI API key used by lib/ai/openai.ts
OPENAI_API_KEY="replace-me"

# Pooled PostgreSQL connection for app runtime queries.
# Example: postgres://user:password@host:6543/dbname?sslmode=require
DATABASE_URL="postgres://user:password@host:6543/dbname?sslmode=require"

# Direct PostgreSQL connection for drizzle-kit migrations.
# Example: postgres://user:password@host:5432/dbname?sslmode=require
DIRECT_URL="postgres://user:password@host:5432/dbname?sslmode=require"
